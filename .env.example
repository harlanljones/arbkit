# Live trading is disabled by default. Keep credentials out of the repository.
ARBKIT_EXEC_MODE=dry-run
ARBKIT_KILL_SWITCH=1
KALSHI_ACCESS_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2
POLY_PRIVATE_KEY=
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
ARBKIT_MAX_STAKE_PER_LEG_CENTS=5000
ARBKIT_MAX_DAILY_LOSS_CENTS=50000
ARBKIT_MAX_OPEN_TRADES=1
ARBKIT_MIN_EDGE_BPS=50
