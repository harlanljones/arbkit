# Live trading is disabled by default. Keep credentials out of the repository.
# Inject real values from a secret manager at runtime; see RUNBOOK.md.
ARBKIT_EXEC_MODE=dry-run
ARBKIT_KILL_SWITCH=1
KALSHI_ACCESS_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
# Adapter base URLs are origins only — each adapter appends its own API path.
KALSHI_API_BASE=https://api.elections.kalshi.com
POLY_WALLET_ADDRESS=
POLY_PRIVATE_KEY=
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
POLY_API_BASE=https://clob.polymarket.com
ARBKIT_MAX_STAKE_PER_LEG_CENTS=5000
ARBKIT_MAX_DAILY_LOSS_CENTS=50000
ARBKIT_MAX_OPEN_TRADES=1
ARBKIT_MIN_EDGE_BPS=50
# prod_trader dry-run bankroll per venue, in cents.
ARBKIT_BANKROLL_CENTS=10000
# Operator identity recorded in the runbook log for kill-switch commands.
ARBKIT_OPERATOR_ID=operator
